<?xml version="1.0" encoding="utf-8"?>
<!--
  배포 설정을 파일로 고정한다.

  이 셋을 명령줄에서 매번 붙여야 했는데, 특히
  IncludeNativeLibrariesForSelfExtract 를 빠뜨리면 exe 하나가 아니라
  libSkiaSharp.dll·av_libglesv2.dll·libHarfBuzzSharp.dll·WebView2Loader.dll 과
  runtimes 폴더가 같이 흩어져 나온다. 그래서 프로필로 박아둔다.

  csproj 의 PropertyGroup 에 넣지 않는 이유는, 거기 두면 dotnet build 와
  dotnet run 까지 self-contained 로 돌아가 개발 중 빌드가 느려지기 때문이다.

  사용법:
    dotnet publish "bms editer/bms editer.csproj" -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>..\publish\win-x64\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
